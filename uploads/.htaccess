# Prevent unauthenticated direct HTTP listing/download of uploaded student files.
# All authorized access goes through backend/api/download_document.php with session RBAC checks.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

