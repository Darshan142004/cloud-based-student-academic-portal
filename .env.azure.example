# EduPulse Cloud / Production Environment Template (DO NOT commit real secrets)

APP_ENV=production
APP_SERVICE_NAME=edupulse-web

# Azure Database for MySQL Flexible Server
DB_HOST=edupulse-mysql.mysql.database.azure.com
DB_PORT=3306
DB_NAME=student_portal
DB_USER=edupulse_admin
DB_PASS=__SET_IN_CONTAINER_APP_SECRET__
DB_SSL_MODE=verify_ca
DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Storage Backend ('local' for Docker dev, 'azure' for Azure Blob Storage)
STORAGE_DRIVER=azure
AZURE_STORAGE_CONNECTION_STRING=__SET_IN_CONTAINER_APP_SECRET__
AZURE_STORAGE_CONTAINER=edupulse-files

# Azure Application Insights Telemetry
APPINSIGHTS_CONNECTION_STRING=__SET_IN_CONTAINER_APP_SECRET__
APP_TELEMETRY_LOG=

